# Setup
correct_password = "MECHANICAL" 
attempts = 0  
is_locked = True

# Logic: Indefinite iteration
while is_locked:
    # prompt the user
    user_input = input("Enter password: ").strip().upper()
    attempts += 1 
    
    if user_input == correct_password:
        print("Access Granted.")
        is_locked = False
    else:
        print(f"Incorrect. (Attempt {attempts})")

# Assessment Data Output
print("\n--- Task 3 Assessment ---")
print(f"Correct Password Set: {correct_password}")
print(f"Input Attempts: {attempts}")
print(f"Attempts Before Success: {attempts - 1}")