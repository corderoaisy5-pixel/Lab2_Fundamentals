# Setup
target_name = "CORDERO" # Replace with your actual surname in UPPERCASE
STUDENT_ID = "TUPM-25-0354"    # Replace with your actual ID
seed_num = int(STUDENT_ID[-1]) 
redacted_name = ""

# Logic: Iterate and replace vowels
for char in target_name:
    if char in "AEIOU":
        redacted_name += str(seed_num)
    else:
        redacted_name += char

# Output for Assessment Data
print(f"Original Surname: {target_name}")
print(f"SEED_NUM Used: {seed_num}")
print(f"Redacted Output: {redacted_name}")

# Setup
engineer_name = "CORDERO"
# We need to wrap the string index in int() correctly
seed_num = int("TUPM-25-0354"[-1]) 
# You must use the variable 'engineer_name', not the literal name CORDERO
total_loops = len(engineer_name)    

# Logic
first_letter_ascii = ord(engineer_name[0])
verification_hash = (first_letter_ascii * seed_num) - total_loops

# Assessment Data Output
